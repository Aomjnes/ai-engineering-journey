# SQLite file (relative to prisma/schema.prisma)
DATABASE_URL="file:./lexiforge.db"

# Exactly one is enough. Auto-detected in this order: Anthropic, OpenAI, Gemini.
ANTHROPIC_API_KEY=""
OPENAI_API_KEY=""
GEMINI_API_KEY=""
# Optional model overrides
ANTHROPIC_MODEL="claude-opus-5-5"
OPENAI_MODEL="gpt-5"
GEMINI_MODEL="gemini-3.5-flash"

# Protects /api/cron/ingest. Generate with: openssl rand -hex 32
CRON_SECRET=""
# Run in-process node-cron ingestion (daily 05:30 server time) when "true"
ENABLE_INTERNAL_CRON="true"
