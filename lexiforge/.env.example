# ── Database (PostgreSQL: Neon / Supabase / any Postgres 14+) ──────────────────────────
# DATABASE_URL: pooled connection used by the app at runtime (Neon: "-pooler" host; Supabase: port 6543 + ?pgbouncer=true)
# DIRECT_URL:   direct (non-pooled) connection used by `prisma db push`
DATABASE_URL="postgresql://USER:PASSWORD@HOST-pooler.REGION.aws.neon.tech/lexiforge?sslmode=require"
DIRECT_URL="postgresql://USER:PASSWORD@HOST.REGION.aws.neon.tech/lexiforge?sslmode=require"

# ── Streams & sessions ─────────────────────────────────────────────────────────────────
# Signs the stream session cookie (HMAC-SHA256). ≥ 32 chars. Generate: openssl rand -hex 32
SESSION_SECRET=""
# Private access codes, comma-separated, max 5 (hard cap). Treat them like passwords.
ALLOWED_STREAM_CODES="000,001,002,003,004"

# ── LLM (one is enough; fallback chain: Anthropic → OpenAI → Gemini keys × models → Groq) ─────────
ANTHROPIC_API_KEY=""
OPENAI_API_KEY=""
GEMINI_API_KEY=""
# Free-tier resilience (see CLAUDE.md "LLM router"): several Gemini keys, rotated on 429 (comma-separated).
GEMINI_API_KEYS=""
# Models tried after GEMINI_MODEL; each has its own free quota bucket.
GEMINI_FALLBACK_MODELS="gemini-2.5-flash-lite,gemini-2.0-flash"
# Free secondary provider (https://console.groq.com/keys), used when every Gemini key/model is rate-limited.
GROQ_API_KEY=""
GROQ_MODEL="llama-3.3-70b-versatile"
# Max concurrent LLM calls per server instance.
LLM_MAX_CONCURRENCY="2"
ANTHROPIC_MODEL="claude-opus-5-5"
OPENAI_MODEL="gpt-5"
GEMINI_MODEL="gemini-2.5-flash"

# ── Ingestion ─────────────────────────────────────────────────────────────────────────
# Protects /api/cron/ingest (Vercel Cron sends "Authorization: Bearer $CRON_SECRET"). ≥ 16 chars.
CRON_SECRET=""
# In-process node-cron scheduler for self-hosting only. Always off on Vercel (VERCEL=1).
ENABLE_INTERNAL_CRON="false"
