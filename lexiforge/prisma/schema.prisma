// LexiForge — complete schema. SQLite for zero-setup local use; every type
// used here maps 1:1 to PostgreSQL (switch `provider` + DATABASE_URL only).

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

// ───────────────────────────── Enums ─────────────────────────────

enum CefrTier {
  A2
  B1
  B2
  C1
}

enum CefrSubBand {
  A2_1
  A2_2
  B1_1
  B1_2
  B2_1
  B2_2
  C1_1
  C1_2
}

enum Severity {
  CRITICAL
  MODERATE
  MINOR
}

enum ErrorCategory {
  GRAMMAR
  COLLOCATION_NATURALNESS
  WORD_CHOICE_REGISTER
  SPELLING_PUNCTUATION
  LOGIC_COMPREHENSION
}

enum LessonStage {
  INPUT
  COMPREHENSION
  PRODUCTION
  EXIT_TICKET
  COMPLETED
}

enum SubmissionKind {
  DIAGNOSTIC_READING
  DIAGNOSTIC_ERROR_DETECTION
  DIAGNOSTIC_WRITING
  COMPREHENSION
  PRODUCTION
  REWRITE
  EXIT_TICKET
  PROMOTION_AUDIT
  DETOX
}

enum DiagnosticKind {
  PLACEMENT
  PROMOTION
}

enum DiagnosticStatus {
  IN_PROGRESS
  COMPLETED
  ABANDONED
}

enum FeedStatus {
  ACTIVE
  FAILING
  DISABLED
}

// ───────────────────────────── Content ─────────────────────────────

model SourceFeed {
  id                  String         @id @default(cuid())
  name                String
  url                 String         @unique
  homepage            String
  topic               String
  status              FeedStatus     @default(ACTIVE)
  consecutiveFailures Int            @default(0)
  lastFetchedAt       DateTime?
  lastError           String?
  createdAt           DateTime       @default(now())
  articles            DailyArticle[]
}

model DailyArticle {
  id                    String       @id @default(cuid())
  feedId                String
  feed                  SourceFeed   @relation(fields: [feedId], references: [id], onDelete: Cascade)
  urlHash               String       @unique // sha256 of normalized URL
  url                   String
  title                 String
  byline                String?
  excerpt               String?
  content               String // clean plain text from Readability
  publishedAt           DateTime?
  ingestedAt            DateTime     @default(now())
  wordCount             Int
  sentenceCount         Int
  // Deterministic complexity profile (src/lib/metrics/readability.ts)
  fleschKincaidGrade    Float
  fleschReadingEase     Float
  avgSentenceLength     Float
  avgSyllablesPerWord   Float
  lexicalSophistication Float // share of content-word tokens outside the core 2k-word band
  cefrTier              CefrTier
  difficultyScore       Float // continuous 0–100 used for i+1 matching
  lessons               LessonUnit[]

  @@index([ingestedAt])
  @@index([cefrTier])
}

model LessonUnit {
  id                String              @id @default(cuid())
  articleId         String
  article           DailyArticle        @relation(fields: [articleId], references: [id], onDelete: Cascade)
  userId            String
  user              User                @relation(fields: [userId], references: [id], onDelete: Cascade)
  targetSubBand     CefrSubBand
  difficultyScore   Float // difficulty of the text the learner actually reads
  isGraded          Boolean // true when a bridge (graded) version was synthesized
  readingText       String // text served for Stage 1 (bridge or authentic)
  authenticExcerpt  String // original passage, always shown for transparency
  comprehensibility Float // estimated share of known tokens (target 0.85–0.90)
  grammarInWild     Json // [{pattern, example, explanationEn, explanationVi}]
  questions         Json // Stage 2 questions [{id, type, prompt, rubric:[...]}]
  productionPrompt  String
  stage             LessonStage         @default(INPUT)
  createdAt         DateTime            @default(now())
  completedAt       DateTime?
  chunks            LexicalChunk[]
  submissions       SubmissionAttempt[]

  @@index([userId, createdAt])
}

model LexicalChunk {
  id             String     @id @default(cuid())
  lessonId       String
  lesson         LessonUnit @relation(fields: [lessonId], references: [id], onDelete: Cascade)
  phrase         String
  sourceSentence String
  meaningEn      String
  meaningVi      String
  cefrTier       CefrTier
  isStretch      Boolean // part of the +1 band
  srsCards       SrsCard[]
}

// ───────────────────────────── Learning & Grading ─────────────────────────────

model User {
  id               String                 @id @default(cuid())
  displayName      String                 @default("Learner")
  createdAt        DateTime               @default(now())
  settings         UserSettings?
  progress         UserProgress?
  profile          ProficiencyProfile?
  snapshots        ProficiencySnapshot[]
  diagnostics      DiagnosticAssessment[]
  lessons          LessonUnit[]
  submissions      SubmissionAttempt[]
  errors           ErrorLog[]
  srsCards         SrsCard[]
}

model UserSettings {
  id            String   @id @default(cuid())
  userId        String   @unique
  user          User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  ttsRate       Float    @default(1.0)
  ttsVoice      String?
  dailyNewChunk Int      @default(6)
  timezone      String   @default("Asia/Ho_Chi_Minh")
  updatedAt     DateTime @updatedAt
}

model UserProgress {
  id                 String    @id @default(cuid())
  userId             String    @unique
  user               User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  lessonsCompleted   Int       @default(0)
  lastLessonAt       DateTime?
  lastReviewAt       DateTime?
  lastDetoxAt        DateTime?
  activeLessonId     String?
  updatedAt          DateTime  @updatedAt
}

model SubmissionAttempt {
  id               String         @id @default(cuid())
  userId           String
  user             User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  lessonId         String?
  lesson           LessonUnit?    @relation(fields: [lessonId], references: [id], onDelete: Cascade)
  diagnosticId     String?
  diagnostic       DiagnosticAssessment? @relation(fields: [diagnosticId], references: [id], onDelete: Cascade)
  kind             SubmissionKind
  questionId       String?
  text             String
  attemptNumber    Int            @default(1)
  wordCount        Int
  taskDifficulty   Float // 0–100 scale of the task (same scale as article difficulty)
  copySimilarity   Float? // max Jaccard vs. source (0–1)
  rejected         Boolean        @default(false)
  rejectionReason  String?
  evidence         Json? // raw Zod-validated LLM evidence (spans, rubric booleans)
  gai              Float?
  lri              Float?
  cpr              Float?
  passedGate       Boolean        @default(false)
  createdAt        DateTime       @default(now())
  errors           ErrorLog[]

  @@index([userId, createdAt])
}

model ErrorLog {
  id           String            @id @default(cuid())
  userId       String
  user         User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  submissionId String
  submission   SubmissionAttempt @relation(fields: [submissionId], references: [id], onDelete: Cascade)
  category     ErrorCategory
  subtype      String // e.g. ARTICLE_OMISSION, TENSE_SHIFT, PREPOSITION_CALQUE
  severity     Severity
  spanStart    Int
  spanEnd      Int
  original     String
  correction   String
  ruleEn       String
  ruleVi       String
  resolved     Boolean           @default(false)
  createdAt    DateTime          @default(now())

  @@index([userId, subtype, createdAt])
}

model SrsCard {
  id            String        @id @default(cuid())
  userId        String
  user          User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  chunkId       String?
  chunk         LexicalChunk? @relation(fields: [chunkId], references: [id], onDelete: SetNull)
  front         String // the chunk
  back          String // meaning + learner's own exit-ticket sentence
  errorSubtype  String? // set for Error-Graveyard drill cards
  // FSRS-4.5 state (src/lib/metrics/srs.ts)
  stability     Float         @default(0)
  difficulty    Float         @default(0)
  reps          Int           @default(0)
  lapses        Int           @default(0)
  state         String        @default("NEW") // NEW | LEARNING | REVIEW | RELEARNING
  lastReviewAt  DateTime?
  dueAt         DateTime      @default(now())
  createdAt     DateTime      @default(now())
  reviews       SrsReview[]

  @@index([userId, dueAt])
}

model SrsReview {
  id              String   @id @default(cuid())
  cardId          String
  card            SrsCard  @relation(fields: [cardId], references: [id], onDelete: Cascade)
  rating          Int // 1 Again, 2 Hard, 3 Good, 4 Easy
  elapsedDays     Float
  retrievability  Float // predicted recall probability at review time
  recalled        Boolean
  reviewedAt      DateTime @default(now())

  @@index([cardId, reviewedAt])
}

// ───────────────────────────── Proficiency & Metrics ─────────────────────────────

model ProficiencyProfile {
  id                    String      @id @default(cuid())
  userId                String      @unique
  user                  User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  subBand               CefrSubBand
  ieltsEstimate         Float
  ieltsLow              Float
  ieltsHigh             Float
  gai                   Float
  lri                   Float
  cpr                   Float
  rss                   Float
  eri                   Float // 0–100, higher = errors decaying (good)
  composite             Float
  abilityLevel          Float // continuous 0–100 level scale (12.5 per sub-band)
  rssReviews            Int         @default(0) // mature reviews behind RSS (0 = no evidence)
  eriSessions           Int         @default(0) // graded production sessions behind ERI
  evidenceWords         Int         @default(0) // total words graded (drives CI width)
  evidenceItems         Int         @default(0) // total objective items graded
  consecutiveQualifying Int         @default(0)
  promotionAuditUnlocked Boolean    @default(false)
  lastActivityAt        DateTime    @default(now())
  calibratedAt          DateTime    @default(now())
  updatedAt             DateTime    @updatedAt
}

model ProficiencySnapshot {
  id             String      @id @default(cuid())
  userId         String
  user           User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  takenAt        DateTime    @default(now())
  subBand        CefrSubBand
  ieltsEstimate  Float
  gai            Float
  lri            Float
  cpr            Float
  rss            Float
  eri            Float
  composite      Float
  abilityLevel   Float
  errorsPer100W  Float?
  trigger        String // DIAGNOSTIC | SESSION | DECAY | PROMOTION | DEMOTION

  @@index([userId, takenAt])
}

model DiagnosticAssessment {
  id           String              @id @default(cuid())
  userId       String
  user         User                @relation(fields: [userId], references: [id], onDelete: Cascade)
  kind         DiagnosticKind
  status       DiagnosticStatus    @default(IN_PROGRESS)
  targetBand   CefrSubBand? // promotion audit only
  itemsJson    Json // served items (answer keys stay server-side)
  readingScore Float?
  errorScore   Float?
  writingGai   Float?
  writingLri   Float?
  resultBand   CefrSubBand?
  resultIelts  Float?
  passed       Boolean?
  startedAt    DateTime            @default(now())
  completedAt  DateTime?
  submissions  SubmissionAttempt[]
}
