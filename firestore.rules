rules_version = '2';
// Chỉ chính bạn, sau khi đăng nhập Google, mới đọc và ghi được dữ liệu của mình.
// Script trên máy và GitHub Actions dùng service account nên không bị Rules chặn.
service cloud.firestore {
  match /databases/{database}/documents {
    match /users/{uid}/{document=**} {
      allow read, write: if request.auth != null && request.auth.uid == uid;
    }
  }
}
